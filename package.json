{
  "name": "agent-board",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @agent-board/server",
    "start": "npm start -w @agent-board/server",
    "build": "npm run build -w agentroom",
    "test": "npm run build && node --test packages/server/test/ packages/client/test/ packages/bots/test/ packages/core/test/",
    "scenario": "npm run build && node packages/bots/src/scenario.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
